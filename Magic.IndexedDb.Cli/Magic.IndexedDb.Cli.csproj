<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>magicdb</ToolCommandName>
    <PackageId>Magic.IndexedDb.Cli</PackageId>
    <Version>3.0.0-preview.1</Version>
    <Authors>Magic Man</Authors>
    <Description>Code-first, language-independent migration planning, validation, and static publishing for Magic IndexedDB.</Description>
    <PackageProjectUrl>https://github.com/magiccodingman/Magic.IndexedDb</PackageProjectUrl>
    <RepositoryUrl>https://github.com/magiccodingman/Magic.IndexedDb</RepositoryUrl>
    <PackageTags>IndexedDB;Blazor;migrations;dotnet-tool;code-first</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Include="../shared/Magic.IndexedDb.Protocol/CanonicalJson.cs" Link="Protocol/CanonicalJson.cs" />
  </ItemGroup>
</Project>
