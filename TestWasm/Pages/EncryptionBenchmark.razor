@page "/encryption-benchmark"
@using System.Diagnostics
@using System.Text.Json
@using Magic.IndexedDb
@using TestWasm.Models
@inject IMagicIndexedDb Magic
@inject IMagicIndexedDbEncryption Encryption

<h1>Magic encryption benchmark</h1>
<pre id="encryption-result">@result</pre>

@code {
    [SupplyParameterFromQuery] public string? Mode { get; set; }
    [SupplyParameterFromQuery] public bool Reload { get; set; }
    [SupplyParameterFromQuery] public bool Navigated { get; set; }
    private string result = "Running";
    [SupplyParameterFromQuery] public int Rows { get; set; } = 1000;
    [SupplyParameterFromQuery] public int Characters { get; set; } = 256;
    private const int PointCount = 25;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            result = JsonSerializer.Serialize(await RunAsync());
        }
        catch (Exception error)
        {
            result = error.ToString();
        }
        StateHasChanged();
    }

    private async Task<Dictionary<string, double>> RunAsync()
    {
        if (Rows < 100 || Rows > 20000 || Rows % 10 != 0 || Characters < 1 || Characters > 8192)
            throw new ArgumentOutOfRangeException(nameof(Rows), "Use 100-20,000 rows in multiples of 10 and 1-8,192 characters.");
        var payload = new string('x', Characters);
        var timings = new Dictionary<string, double>();
        var start = Stopwatch.StartNew();
        var encrypted = Mode == "protected";
        var query = encrypted
            ? await Magic.Query<EncryptionBenchmarkRecord>(row => row.Databases.ProtectedSelection)
            : await Magic.Query<EncryptionBenchmarkRecord>();
        var database = EncryptionBenchmarkRepository.Protected;
        timings["querySetupMs"] = start.Elapsed.TotalMilliseconds;

        if (Navigated)
        {
            if ((await query.FirstOrDefaultAsync(row => row.Id == 1))?.Payload != payload)
                throw new InvalidOperationException("SPA navigation lost the unlocked session.");
            timings["navigationPassed"] = 1;
            return timings;
        }

        if (Reload)
        {
            try
            {
                await query.ToListAsync();
                throw new InvalidOperationException("Reload unexpectedly retained the key.");
            }
            catch (MagicEncryptionLockedException)
            {
            }
            if (!await Encryption.EnsureUnlockedAsync(database) ||
                (await query.FirstOrDefaultAsync(row => row.Id == 1))?.Payload != payload)
                throw new InvalidOperationException("Reload verification failed.");
            await Encryption.LockAsync(database);
            if ((await query.SelectPublicAsync(row => row.Id)).Count != Rows)
                throw new InvalidOperationException("Verified locked projection failed.");

            timings["reloadPassed"] = 1;
            return timings;
        }

        if (encrypted)
        {
            start.Restart();
            if (!await Encryption.InitializeAsync(database))
                throw new InvalidOperationException("The fixture key was unavailable.");
            timings["provisionMs"] = start.Elapsed.TotalMilliseconds;
        }

        var rows = Enumerable.Range(1, Rows).Select(id =>
            new EncryptionBenchmarkRecord { Id = id, Group = id % 10, Payload = payload }).ToArray();

        start.Restart();
        foreach (var record in rows.Take(PointCount))
            await query.AddAsync(record);
        timings["pointWriteMs"] = start.Elapsed.TotalMilliseconds;

        await query.ClearTable();
        start.Restart();
        await query.AddRangeAsync(rows);
        timings["bulkWriteMs"] = start.Elapsed.TotalMilliseconds;

        start.Restart();
        foreach (int id in Enumerable.Range(1, PointCount))
        {
            var row = await query.FirstOrDefaultAsync(record => record.Id == id);
            if (row?.Payload != payload)
                throw new InvalidOperationException("Point read returned the wrong record.");
        }
        timings["pointReadMs"] = start.Elapsed.TotalMilliseconds;

        start.Restart();
        var indexed = await query.Where(record => record.Group == 0).ToListAsync();
        timings["indexReadMs"] = start.Elapsed.TotalMilliseconds;
        if (indexed.Count != Rows / 10 || indexed.Any(row => row.Payload != payload))
            throw new InvalidOperationException("Indexed read returned invalid records.");

        start.Restart();
        var all = await query.ToListAsync();
        timings["scanMs"] = start.Elapsed.TotalMilliseconds;
        if (all.Count != Rows || all.Any(row => row.Payload != payload))
            throw new InvalidOperationException("Full scan returned invalid records.");

        return timings;
    }
}
