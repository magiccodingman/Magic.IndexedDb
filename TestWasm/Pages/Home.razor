                <td>@person._Age</td>
                <td>
                    <div style="max-width: 400px; overflow-x: auto;">
                        @person.DoNotMapTest
                    </div>
                </td>

                <td>@person.Access</td>
            </tr>
        }
    </tbody>
</table>

