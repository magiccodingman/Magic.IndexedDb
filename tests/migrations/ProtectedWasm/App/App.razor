@namespace ProtectedFixture
@using Magic.IndexedDb
@using Microsoft.JSInterop
@inject IMagicEncryptionContexts Contexts
@inject IJSRuntime Js
<output id="fixture-result" data-state="@state">@message</output>

@code {
    private string state = "running";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var fixture = await Js.InvokeAsync<IJSObjectReference>("import", "./protected-fixture.mjs");
            await fixture.InvokeVoidAsync("seed");
            var context = await Activate("published-account");
            var encryption = context.Encryption;
            var records = ProtectedRepository.Records;
            var database = await context.Database.Database(records);
            FixtureKeys.KeyByte = null;
            Require(await encryption.UnlockDetailedAsync(records) == MagicUnlockResult.KeyUnavailable, "Missing key was not reported.");
            FixtureKeys.KeyByte = 56;
            Require(await encryption.UnlockDetailedAsync(records) == MagicUnlockResult.InvalidKey, "Wrong key was not rejected.");
            Require((await database.InspectMigrationAsync())!.Value.GetProperty("state").ValueKind == System.Text.Json.JsonValueKind.Null,
                "Failed authorization admitted a journal.");
            await fixture.InvokeVoidAsync("assertOriginalCiphertext");
            FixtureKeys.KeyByte = 55;
            var notifications = 0;
            await using (await context.Database.ObserveMigrationsAsync(notification =>
            {
                if (notification.SchemaId == "protected-wasm") notifications++;
                return ValueTask.CompletedTask;
            }))
            {
                var stopped = encryption.UnlockDetailedAsync(records);
                await fixture.InvokeVoidAsync("waitForHook");
                await database.CancelMigrationAsync();
                Require(await stopped == MagicUnlockResult.Cancelled, "Browser cancellation was not reported.");
                await fixture.InvokeVoidAsync("resetHookProbe");
                var pending = encryption.EnsureUnlockedAsync(records);
                await fixture.InvokeVoidAsync("waitForHook");
                using var wait = new CancellationTokenSource();
                var secondWait = encryption.EnsureUnlockedAsync(records, wait.Token);
                wait.Cancel();
                try { await secondWait; throw new InvalidOperationException("The caller's wait was not cancelled."); }
                catch (OperationCanceledException) { }
                Require(!pending.IsCompleted, "Cancelling a caller's wait stopped the browser migration.");
                await encryption.LockAsync(records);
                try
                {
                    await pending;
                    throw new InvalidOperationException("Lock did not revoke the migration.");
                }
                catch (JSException error) when (error.Message.Contains("MAGDB_AUTHORIZATION_LOST", StringComparison.Ordinal) ||
                    error.Message.Contains("MAGDB_CANCELLED", StringComparison.Ordinal)) { }
                var checkpoint = (await database.InspectMigrationAsync())!.Value.GetProperty("state");
                Require(checkpoint.GetProperty("status").GetString() == "migrating" &&
                    checkpoint.GetProperty("active").GetProperty("processedRecords").GetInt32() == 0,
                    "A revoked transform committed records.");
                await fixture.InvokeVoidAsync("assertOriginalCiphertext");
                await fixture.InvokeVoidAsync("releaseHook");
                Require(await encryption.EnsureUnlockedAsync(records), "Retry was not authorized.");
                Require(notifications > 0, "Migration observation did not run.");
            }

            await database.OpenAsync();
            var query = await database.Query<ProtectedRow>();
            var rows = await query.ToListAsync();
            Require(rows.Count == 3 && rows.All(row => row.Secret == "Private " + row.Id && row.Name == "Public " + row.Id && row.Visits == 1),
                "Typed data was lost or a transformation replayed.");
            await fixture.InvokeVoidAsync("assertFinalPlaintext");
            var final = (await database.InspectMigrationAsync())!.Value.GetProperty("state");
            Require(final.GetProperty("protocolVersion").GetInt32() == 3 && final.GetProperty("revision").GetInt32() == 3 &&
                final.GetProperty("history").GetArrayLength() == 2, "Authenticated lineage was not retained.");
            await encryption.LockAsync(records);
            Require(await encryption.EnsureUnlockedAsync(records), "The public final policy could not be reopened.");
            var other = await Activate("another-account");
            Require(await encryption.GetStateAsync(records) == MagicEncryptionState.Inactive, "The previous account context survived switching.");
            Require(await other.Encryption.UnlockDetailedAsync(records) == MagicUnlockResult.InvalidKey,
                "A wrong account was able to open authenticated history.");
            var resumed = await Activate("published-account");
            Require(await resumed.Encryption.EnsureUnlockedAsync(records), "The original account could not reauthorize.");
            await Contexts.DeactivateAsync();
            Require(await resumed.Encryption.GetStateAsync(records) == MagicEncryptionState.Inactive, "Sign-out did not release the account context.");
            Require(FixtureKeys.Requests >= 3, "Explicit locking did not require fresh authorization.");
            await ExerciseEncryptedRotation(fixture);
            state = "passed";
            message = "Authenticated legacy adoption, lock/resume, field-to-record encryption, approved declassification, and interrupted encrypted key rotation passed.";
        }
        catch (Exception error)
        {
            state = "failed";
            message = error.ToString();
        }
    }

    private async Task ExerciseEncryptedRotation(IJSObjectReference fixture)
    {
        var records = ProtectedRepository.RotationRecords;
        var context = await Activate("published-account");
        Require(await context.Encryption.InitializeAsync(records), "The encrypted rotation fixture could not initialize.");
        var database = await context.Database.Database(records);
        var table = await database.Query<RotationRow>();
        foreach (var id in new[] { 1, 2, 3 })
            await table.AddAsync(new RotationRow { Id = id, Secret = "Document " + id });
        var expected = new RotationRow { Id = 1 };
        var workspace = new RotationRow { Id = 2 };
        var next = new RotationRow { Id = 1, Revision = 1, Secret = "Document 1" };
        Require(await table.ReplaceProtectedIfCurrentAsync(expected, next, row => row.Revision,
            table, workspace, row => row.Generation) == MagicConditionalMutationResult.Applied, "The matching mutation failed.");
        Require(await table.DeleteProtectedIfCurrentAsync(expected, row => row.Revision,
            table, workspace, row => row.Generation) == MagicConditionalMutationResult.Conflict, "A stale revision deleted a record.");
        Require(await table.InsertProtectedIfCurrentAsync(new RotationRow { Id = 4, Generation = 1, Secret = "Temporary document" },
            table, workspace, row => row.Generation) == MagicConditionalMutationResult.Applied, "The guarded insert failed.");
        workspace.Generation = 1;
        workspace.Id = 4;
        Require(await table.DeleteProtectedIfCurrentAsync(next, row => row.Revision, table,
            new RotationRow { Id = 4 }, row => row.Generation) == MagicConditionalMutationResult.Conflict, "A stale generation deleted a record.");
        Require(await table.DeleteProtectedIfCurrentAsync(workspace, row => row.Revision, table,
            workspace, row => row.Generation) == MagicConditionalMutationResult.Applied, "The matching delete failed.");
        Require((await table.ToListAsync()).Any(row => row.Id == 1 && row.Revision == 1 && row.Secret == "Document 1"),
            "A conflict changed the protected record.");
        var oldFence = new RotationRow { Id = 2 };
        var advancedFence = new RotationRow { Id = 2, Revision = 1, Generation = 1, Secret = "Document 2" };
        Require(await table.ReplaceProtectedIfCurrentAsync(oldFence, advancedFence, row => row.Revision,
            table, oldFence, row => row.Generation) == MagicConditionalMutationResult.Applied, "The fence could not advance itself.");
        Require(await table.InsertProtectedIfCurrentAsync(new RotationRow { Id = 4, Secret = "Stale generation" },
            table, oldFence, row => row.Generation) == MagicConditionalMutationResult.Conflict, "The retired generation inserted a record.");
        var ready = await context.KeyRotation.GetKeyRotationStatusAsync(records);
        Require(ready.Phase == MagicKeyRotationPhase.NotStarted && ready.ReadsAllowed && ready.WritesAllowed &&
            !ready.RetirementReady, "A ready vault reported incorrect availability before its first rotation.");
        await fixture.InvokeVoidAsync("assertRotationCiphertext", ProtectedRepository.RotationPhysicalName,
            new[] { "rotation-source", "rotation-source", "rotation-source" });

        await fixture.InvokeVoidAsync("holdRotationAfterFirstRecord");
        var running = context.KeyRotation.RotateEncryptionKeyAsync(records,
            new("rotation-target", MagicKeyRotationMode.Online, BatchSize: 1));
        try
        {
            await fixture.InvokeVoidAsync("waitForRotationCrypto");
            await context.KeyRotation.CancelKeyRotationAsync(records);
        }
        finally { await fixture.InvokeVoidAsync("releaseRotationCrypto"); }
        try
        {
            await running;
            throw new InvalidOperationException("The rotation unexpectedly completed after cancellation.");
        }
        catch (JSException error) when (error.Message.Contains("abort", StringComparison.OrdinalIgnoreCase)) { }

        var interrupted = await context.KeyRotation.GetKeyRotationStatusAsync(records);
        Require(interrupted.Phase == MagicKeyRotationPhase.Converting && interrupted.Converted == 1 &&
            !interrupted.RetirementReady, "Cancellation did not preserve the expected conversion checkpoint.");
        await fixture.InvokeVoidAsync("assertRotationCiphertext", ProtectedRepository.RotationPhysicalName,
            new[] { "rotation-target", "rotation-source", "rotation-source" });
        await Contexts.DeactivateAsync();

        FixtureKeys.RotationRequests.Clear();
        context = await Activate("published-account");
        var completed = await context.KeyRotation.ResumeKeyRotationAsync(records, batchSize: 1);
        Require(FixtureKeys.RotationRequests.SequenceEqual(new[] { "rotation-source", "rotation-target" }),
            "Resuming did not reacquire both generations through the provider.");
        Require(completed.Phase == MagicKeyRotationPhase.Completed && completed.RetirementReady &&
            completed.Converted == 3 && completed.Verified == 3 && completed.TargetKeyId == "rotation-target",
            "Resuming did not complete the verified encrypted rotation.");
        await fixture.InvokeVoidAsync("assertRotationCiphertext", ProtectedRepository.RotationPhysicalName,
            new[] { "rotation-target", "rotation-target", "rotation-target" });

        await Contexts.DeactivateAsync();
        FixtureKeys.RotationSourceAvailable = false;
        FixtureKeys.RotationRequests.Clear();
        context = await Activate("published-account");
        Require(await context.Encryption.EnsureUnlockedAsync(records), "The completed vault did not reopen with only the target key.");
        Require(FixtureKeys.RotationRequests.SequenceEqual(new[] { "rotation-target" }), "Reopening requested the retired key.");
        database = await context.Database.Database(records);
        table = await database.Query<RotationRow>();
        var rows = await table.ToListAsync();
        Require(rows.Count == 3 && rows.All(row => row.Secret == "Document " + row.Id), "Rotation changed typed data.");
        await Contexts.DeactivateAsync();
    }

    private Task<MagicEncryptionContext> Activate(string account) => Contexts.ActivateAsync(
        [new MagicEncryptionOptions("protected-wasm", account, "fixture-key")
            { PhysicalDatabaseName = ProtectedRepository.PhysicalName },
         new MagicEncryptionOptions("rotation-wasm", account, "rotation-source")
            { PhysicalDatabaseName = ProtectedRepository.RotationPhysicalName }]);

    private static void Require(bool condition, string message)
    {
        if (!condition) throw new InvalidOperationException(message);
    }
}
