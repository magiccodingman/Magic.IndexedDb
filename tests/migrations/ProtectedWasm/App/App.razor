@namespace ProtectedFixture
@using Magic.IndexedDb
@using Microsoft.JSInterop
@inject IMagicEncryptionContexts Contexts
@inject IJSRuntime Js
<output id="fixture-result" data-state="@state">@message</output>

@code {
    private string state = "running";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var fixture = await Js.InvokeAsync<IJSObjectReference>("import", "./protected-fixture.mjs");
            await fixture.InvokeVoidAsync("seed");
            var context = await Activate("published-account");
            var encryption = context.Encryption;
            var records = ProtectedRepository.Records;
            var database = await context.Database.Database(records);
            FixtureKeys.KeyByte = null;
            Require(await encryption.UnlockDetailedAsync(records) == MagicUnlockResult.KeyUnavailable, "Missing key was not reported.");
            FixtureKeys.KeyByte = 56;
            Require(await encryption.UnlockDetailedAsync(records) == MagicUnlockResult.InvalidKey, "Wrong key was not rejected.");
            Require((await database.InspectMigrationAsync())!.Value.GetProperty("state").ValueKind == System.Text.Json.JsonValueKind.Null,
                "Failed authorization admitted a journal.");
            await fixture.InvokeVoidAsync("assertOriginalCiphertext");
            FixtureKeys.KeyByte = 55;
            var notifications = 0;
            await using (await context.Database.ObserveMigrationsAsync(notification =>
            {
                if (notification.SchemaId == "protected-wasm") notifications++;
                return ValueTask.CompletedTask;
            }))
            {
                var stopped = encryption.UnlockDetailedAsync(records);
                await fixture.InvokeVoidAsync("waitForHook");
                await database.CancelMigrationAsync();
                Require(await stopped == MagicUnlockResult.Cancelled, "Browser cancellation was not reported.");
                await fixture.InvokeVoidAsync("resetHookProbe");
                var pending = encryption.EnsureUnlockedAsync(records);
                await fixture.InvokeVoidAsync("waitForHook");
                using var wait = new CancellationTokenSource();
                var secondWait = encryption.EnsureUnlockedAsync(records, wait.Token);
                wait.Cancel();
                try { await secondWait; throw new InvalidOperationException("The caller's wait was not cancelled."); }
                catch (OperationCanceledException) { }
                Require(!pending.IsCompleted, "Cancelling a caller's wait stopped the browser migration.");
                await encryption.LockAsync(records);
                try
                {
                    await pending;
                    throw new InvalidOperationException("Lock did not revoke the migration.");
                }
                catch (JSException error) when (error.Message.Contains("MAGDB_AUTHORIZATION_LOST", StringComparison.Ordinal) ||
                    error.Message.Contains("MAGDB_CANCELLED", StringComparison.Ordinal)) { }
                var checkpoint = (await database.InspectMigrationAsync())!.Value.GetProperty("state");
                Require(checkpoint.GetProperty("status").GetString() == "migrating" &&
                    checkpoint.GetProperty("active").GetProperty("processedRecords").GetInt32() == 0,
                    "A revoked transform committed records.");
                await fixture.InvokeVoidAsync("assertOriginalCiphertext");
                await fixture.InvokeVoidAsync("releaseHook");
                Require(await encryption.EnsureUnlockedAsync(records), "Retry was not authorized.");
                Require(notifications > 0, "Migration observation did not run.");
            }

            await database.OpenAsync();
            var query = await database.Query<ProtectedRow>();
            var rows = await query.ToListAsync();
            Require(rows.Count == 3 && rows.All(row => row.Secret == "Private " + row.Id && row.Name == "Public " + row.Id && row.Visits == 1),
                "Typed data was lost or a transformation replayed.");
            await fixture.InvokeVoidAsync("assertFinalPlaintext");
            var final = (await database.InspectMigrationAsync())!.Value.GetProperty("state");
            Require(final.GetProperty("protocolVersion").GetInt32() == 3 && final.GetProperty("revision").GetInt32() == 3 &&
                final.GetProperty("history").GetArrayLength() == 2, "Authenticated lineage was not retained.");
            await encryption.LockAsync(records);
            Require(await encryption.EnsureUnlockedAsync(records), "The public final policy could not be reopened.");
            var other = await Activate("another-account");
            Require(await encryption.GetStateAsync(records) == MagicEncryptionState.Inactive, "The previous account context survived switching.");
            Require(await other.Encryption.UnlockDetailedAsync(records) == MagicUnlockResult.InvalidKey,
                "A wrong account was able to open authenticated history.");
            var resumed = await Activate("published-account");
            Require(await resumed.Encryption.EnsureUnlockedAsync(records), "The original account could not reauthorize.");
            await Contexts.DeactivateAsync();
            Require(await resumed.Encryption.GetStateAsync(records) == MagicEncryptionState.Inactive, "Sign-out did not release the account context.");
            Require(FixtureKeys.Requests >= 3, "Explicit locking did not require fresh authorization.");
            state = "passed";
            message = "Authenticated legacy adoption, lock/resume, field-to-record encryption and approved declassification passed.";
        }
        catch (Exception error)
        {
            state = "failed";
            message = error.ToString();
        }
    }

    private Task<MagicEncryptionContext> Activate(string account) => Contexts.ActivateAsync(
        [new MagicEncryptionOptions("protected-wasm", account, "fixture-key")
            { PhysicalDatabaseName = ProtectedRepository.PhysicalName }]);

    private static void Require(bool condition, string message)
    {
        if (!condition) throw new InvalidOperationException(message);
    }
}
