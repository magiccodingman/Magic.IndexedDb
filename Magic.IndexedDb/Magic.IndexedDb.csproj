<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Title>Magic.IndexedDb</Title>
		<Authors>Magic Man</Authors>
		<Copyright>MIT</Copyright>
		<Description>A LINQ-to-IndexedDB query engine and typed browser database library for Blazor and .NET 10, with indexed query planning, cursor fallback, streaming results, and C# schema definitions.</Description>
		<PackageProjectUrl>https://github.com/magiccodingman/Magic.IndexedDb</PackageProjectUrl>
		<RepositoryUrl>https://github.com/magiccodingman/Magic.IndexedDb</RepositoryUrl>
		<PackageTags>IndexedDB;Blazor;Blazor WebAssembly;LINQ;offline-first;client-side database;browser storage;PWA;Dexie</PackageTags>
		<PackageIcon>wizardHatIcon.png</PackageIcon>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyVersion>3.0.0.0</AssemblyVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<FileVersion>3.0.0.0</FileVersion>
		<Version>3.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\wizardHatIcon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<InternalsVisibleTo Include="Magic.IndexedDb.UnitTests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
		<PackageReference Include="System.Linq.Async" Version="7.0.1" />
	</ItemGroup>
</Project>
